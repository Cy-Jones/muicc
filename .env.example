# Root Environment Configuration (MULSU_ICC 2026)
# The backend reads backend/.env and the frontend reads frontend/.env.
# This file documents the full set for convenience.

PORT=5000
NODE_ENV=development

# Database (libSQL / Turso) — see backend/.env.example
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=

# Admin authentication — override both in production
ADMIN_EMAIL=admin@miucc2026.org
ADMIN_PASSWORD=AdminPassword2026!
JWT_SECRET=change_me_in_production

# Frontend
VITE_API_URL=http://localhost:5000
