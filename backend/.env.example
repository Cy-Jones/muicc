# Backend Environment Variables (MULSU_ICC 2026)

PORT=5000
NODE_ENV=development

# --- Database (libSQL / Turso) ---
# Local development: a local file, no auth token needed.
# Production:        libsql://<database>-<org>.turso.io  + TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=

# --- Admin authentication ---
# Override BOTH of these in production. Never ship these defaults.
ADMIN_EMAIL=admin@miucc2026.org
ADMIN_PASSWORD=AdminPassword2026!
JWT_SECRET=change_me_in_production

# Opt-in for the legacy sample-data purge. Leave unset in production:
# it is the only destructive statement remaining in the seed path.
# ALLOW_DESTRUCTIVE_SEED=true

# --- Cloudinary (Image Storage for Production) ---
# Set these in your production environment to enable persistent image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
